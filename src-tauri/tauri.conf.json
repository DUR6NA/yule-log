{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yule Log",
  "version": "1.0.0",
  "identifier": "com.midwest.yulelog",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Yule Log",
        "width": 1280,
        "height": 800,
        "minWidth": 520,
        "minHeight": 380,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0e0806"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A Yule log heated by a local AI model writing Christmas carols",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Yule Log",
    "copyright": "Heated by a graphics card",
    "category": "Entertainment",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
